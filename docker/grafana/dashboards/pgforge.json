{
  "title": "pgforge",
  "uid": "pgforge",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "tags": ["pgforge"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "App up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "up{job=\"pgforge-app\"}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP requests / sec",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "targets": [
        { "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"pgforge-app\"}[1m]))", "legendFormat": "{{uri}}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HikariCP active connections",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "hikaricp_connections_active{job=\"pgforge-app\"}", "legendFormat": "active", "refId": "A" },
        { "expr": "hikaricp_connections_idle{job=\"pgforge-app\"}", "legendFormat": "idle", "refId": "B" }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Experiment 1 — Concurrency",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Transfer latency by strategy (p95 / p99)",
      "gridPos": { "x": 0, "y": 17, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le, strategy) (rate(ledger_transfer_seconds_bucket{job=\"pgforge-app\"}[1m])))", "legendFormat": "{{strategy}} p99", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, strategy) (rate(ledger_transfer_seconds_bucket{job=\"pgforge-app\"}[1m])))", "legendFormat": "{{strategy}} p95", "refId": "B" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transfer throughput by strategy",
      "gridPos": { "x": 12, "y": 17, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (strategy) (rate(ledger_transfer_seconds_count{job=\"pgforge-app\"}[1m]))", "legendFormat": "{{strategy}} req/s", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Optimistic retries & exhaustions",
      "gridPos": { "x": 0, "y": 25, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(ledger_transfer_retries_total{job=\"pgforge-app\", strategy=\"optimistic\"}[1m])", "legendFormat": "retries", "refId": "A" },
        { "expr": "rate(ledger_transfer_exhaustions_total{job=\"pgforge-app\", strategy=\"optimistic\"}[1m])", "legendFormat": "exhausted", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pessimistic deadlocks & insufficient funds",
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(ledger_transfer_deadlocks_total{job=\"pgforge-app\"}[1m])", "legendFormat": "deadlocks", "refId": "A" },
        { "expr": "increase(ledger_transfer_insufficient_funds_total{job=\"pgforge-app\"}[1m])", "legendFormat": "insufficient funds", "refId": "B" }
      ]
    }
  ]
}
